.venv/
__pycache__/
*.pyc
build/
logs/*.jsonl
*.so
*.pyd
third_party/sts_lightspeed/build/
.pytest_cache/
checkpoints/
# logs/：运行期日志（*.jsonl / 大体积原始数据）不入库，但**分析报告（*.md）必须入库**
# —— 此前用 `logs/` 整目录忽略，导致所有诊断报告从未被提交（只在工作区，有丢失风险）。
logs/*
!logs/*.md
# 关键实验原始数据（体积小、被分析报告直接引用）——显式白名单，不用 !logs/*.json 通配
# （通配会一并放行 dim_ablation.json 等 8MB+ 的探针原始数据与临时文件）
!logs/beam_vs_mcts.json
!logs/kb_coverage_probe.json
!logs/shaping_causal.json
!logs/v11_vs_e1_eval.json

# 运行时产物（每次运行重生，不入库）
sts_agent_debug.log
last_state.json

# 外部数据（人类 .run 数据集克隆；体积大、可按需重新拉取）
data/external/
# 由 training/human_data.py 重新生成的 BC 数据集
data/human_bc/

# 外部参考源码（CombatSolver / RandomForeseer，只读，勿提交）
reference/

# 探针临时日志 / DLL 历史备份 / 自对弈数据（体积大，不入库）
_tmp_*.log
_tmp_*.txt
*.pyd.bak*
data/self_play/

# 根目录的临时探针脚本（防止再次堆积到根目录）
# ⚠️ 用前导 `/` 限定为根目录：scripts/probes/ 下已归档的历史探针脚本**要被跟踪**，
#    此前写成 `_tmp_*.py` 无前导斜杠，会按文件名匹配到任意层级、误伤归档脚本。
/_tmp_*.py
/tmp_*.py
